# ── Cloudflare R2 (전체 리포트 파일 저장) ────────────────────────────────
# Cloudflare 대시보드 → R2 → "Manage R2 API Tokens"에서 발급
# 버킷: lighthouse (account 02f0426678a5977483be4b2210cdf293)
CF_ACCOUNT_ID=02f0426678a5977483be4b2210cdf293
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=lighthouse

# ── AWS S3 (대안) ──────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=ap-northeast-2
# S3_BUCKET=lighthouse

# ── CrUX 실제 사용자 데이터 (PageSpeed Insights 필드 데이터) ───────────────
# Google Cloud Console → "Chrome UX Report API" 사용 설정 → API 키 발급
# https://developer.chrome.com/docs/crux/api
CRUX_API_KEY=your_crux_api_key

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# 참고: Firebase Firestore(리포트 메타데이터 DB)는 클라이언트(public/index.html)에서
#       직접 사용하므로 서버 환경변수가 필요 없습니다.
