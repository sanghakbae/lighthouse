# ── CrUX 실제 사용자 데이터 (선택, PageSpeed Insights 필드 데이터) ─────────
# Google Cloud Console → "Chrome UX Report API" 사용 설정 → API 키 발급
# https://developer.chrome.com/docs/crux/api
CRUX_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────
PORT=3000

# 참고: 리포트 저장은 클라이언트(public/index.html)에서 Firebase Firestore로
#       직접 처리하므로 서버 환경변수가 필요 없습니다. (S3/R2 사용 안 함)
